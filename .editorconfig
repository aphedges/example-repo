# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
spelling_language = en-US
trim_trailing_whitespace = true

[*.md]
max_line_length = off

[*.{ipynb,py}]
indent_size = 4
